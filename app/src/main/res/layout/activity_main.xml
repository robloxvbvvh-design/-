<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_name" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <com.mobilecraft.launcher.SkinView
                android:id="@+id/skin_preview"
                android:layout_width="160dp"
                android:layout_height="300dp" />

            <TextView
                android:id="@+id/character_name"
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/model_name"
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tap_to_rotate"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/nickname" />

        <EditText
            android:id="@+id/nickname"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/edit_bg"
            android:hint="@string/nickname_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="16"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim" />

        <Button
            android:id="@+id/btn_character"
            style="@style/McButton"
            android:layout_marginTop="12dp"
            android:text="@string/choose_character" />

        <Button
            android:id="@+id/btn_version"
            style="@style/McButton"
            android:layout_marginTop="8dp"
            android:text="@string/choose_version" />

        <ProgressBar
            android:id="@+id/progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="1000"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            style="@style/Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_play"
            style="@style/McButton.Primary"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="@string/play" />
    </LinearLayout>
</ScrollView>
