<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        style="@style/Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/character_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.mobilecraft.launcher.SkinView
            android:id="@+id/preview"
            android:layout_width="96dp"
            android:layout_height="180dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/preview_name"
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp" />

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/model_title" />

            <Button
                android:id="@+id/model_classic"
                style="@style/McButton"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:text="@string/model_classic"
                android:textSize="13sp" />

            <Button
                android:id="@+id/model_slim"
                style="@style/McButton"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:text="@string/model_slim"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:horizontalSpacing="8dp"
        android:numColumns="3"
        android:stretchMode="columnWidth"
        android:verticalSpacing="8dp" />

    <Button
        android:id="@+id/btn_import"
        style="@style/McButton"
        android:layout_marginTop="8dp"
        android:text="@string/import_skin" />

    <Button
        android:id="@+id/btn_save"
        style="@style/McButton.Primary"
        android:layout_marginTop="8dp"
        android:text="@string/save" />
</LinearLayout>
